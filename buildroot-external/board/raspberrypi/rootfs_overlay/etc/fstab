# <file system>    <mountpt>           <type>      <options>                   <dump> <pass>
/dev/mmcblk0p2     /                   ext4        rw,relatime                 0      1
/dev/mmcblk0p1     /boot               vfat        defaults                    0      2

# Virtual filesystems
proc               /proc               proc        defaults                    0      0
devpts             /dev/pts            devpts      defaults,gid=5,mode=620     0      0
tmpfs              /dev/shm            tmpfs       mode=1777                   0      0
tmpfs              /tmp                tmpfs       mode=1777                   0      0
tmpfs              /run                tmpfs       mode=0755,nosuid,nodev      0      0
sysfs              /sys                sysfs       defaults                    0      0
configfs           /sys/kernel/config  configfs    nosuid,nodev,noexec         0      0
debugfs            /sys/kernel/debug   debugfs     nosuid,nodev,noexec         0      0
tracefs            /sys/kernel/tracing tracefs     nosuid,nodev,noexec         0      0
