#!/bin/sh

# Mount essential filesystems
mount -t proc none /proc
mount -t sysfs none /sys
mount -t devtmpfs none /dev

# Mount tmpfs for /run
mkdir -p /run
mount -t tmpfs tmpfs /run

# Set up basic networking
ip link set lo up
ip link set eth0 up
udhcpc -i eth0

# Your CMS startup logic goes here
# ...

# Keep system running
exec /bin/sh